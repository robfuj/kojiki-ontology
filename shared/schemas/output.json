{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OUTPUT Stage Output Schema",
  "type": "object",
  "required": ["output_id", "strategy_ref", "intervention", "tactics", "channels", "owner", "dependencies", "sla", "measurement"],
  "properties": {
    "output_id": {"type": "string", "pattern": "^OUT-\\d{3}$"},
    "strategy_ref": {"type": "string", "pattern": "^STRAT-\\d{3}$"},
    "intervention": {"type": "string", "minLength": 1},
    "tactics": {"type": "array", "items": {"type": "string"}},
    "channels": {"type": "array", "items": {"type": "string"}},
    "owner": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "sla": {"type": "string"},
    "measurement": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}