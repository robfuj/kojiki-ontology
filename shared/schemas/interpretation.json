{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kojiki.org/schemas/interpretation.json",
  "title": "INTERPRETATION Stage Output",
  "type": "object",
  "required": ["interpretation_id", "synthesis", "confidence", "key_insights", "evidence_refs", "department_requirements"],
  "additionalProperties": false,
  "properties": {
    "interpretation_id": {"type": "string", "pattern": "^INT-[A-Z0-9]{3,}$"},
    "synthesis": {
      "type": "string",
      "minLength": 10,
      "maxLength": 800,
      "description": "Integrated interpretation of all evidence"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Overall confidence in interpretation"
    },
    "key_insights": {
      "type": "array",
      "items": {"type": "string", "maxLength": 300},
      "minItems": 1,
      "maxItems": 5,
      "description": "Atomic insights extracted from evidence"
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^EVD-\\d{3}$"},
      "minItems": 1,
      "description": "References to evidence findings supporting this interpretation"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_ids", "description"],
        "additionalProperties": false,
        "properties": {
          "finding_ids": {
            "type": "array",
            "items": {"type": "string", "pattern": "^FE-\\d{3}$"},
            "minItems": 2,
            "description": "Conflicting finding IDs"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "description": "Nature of the contradiction"
          },
          "resolution": {
            "type": "string",
            "maxLength": 300,
            "description": "How the contradiction was resolved (or 'unresolved')"
          }
        }
      },
      "maxItems": 3,
      "description": "Explicit contradictions found and their resolution"
    },
    "evidence_gaps": {
      "type": "array",
      "items": {"type": "string", "maxLength": 200},
      "maxItems": 5,
      "description": "Questions still unanswered after evidence"
    },
    "department_requirements": {
      "type": "object",
      "additionalProperties": {"type": "string", "maxLength": 500},
      "description": "What each department must achieve based on interpretation"
    }
  }
}