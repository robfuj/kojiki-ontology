{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "INTERPRETATION Stage Output Schema",
  "type": "object",
  "required": ["interpretation_id", "evidence_refs", "diagnosis", "confidence", "alternative_diagnoses_considered", "gaps_requiring_more_evidence"],
  "properties": {
    "interpretation_id": {"type": "string", "pattern": "^INT-\\d{3}$"},
    "evidence_refs": {"type": "array", "items": {"type": "string", "pattern": "^FE-\\d{3}$"}},
    "diagnosis": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "alternative_diagnoses_considered": {"type": "array", "items": {"type": "string"}},
    "gaps_requiring_more_evidence": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}