{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EVIDENCE Stage Output Schema",
  "type": "object",
  "required": ["findings"],
  "properties": {
    "evidence_id": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "finding", "confidence"],
        "properties": {
          "finding_id": {"type": "string"},
          "source": {"type": "string"},
          "finding": {"type": "string"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "citations": {"type": "array", "items": {"type": "string"}},
          "question": {"type": "string"},
          "answer": {"type": "string"},
          "speaker": {"type": "string"},
          "locator": {"type": "string"},
          "retrieval_state": {"type": "string", "enum": ["RETRIEVED", "BLOCKED", "PARTIAL", "UNKNOWN", "SOURCE_VERIFICATION_REQUIRED"]},
          "contradiction_info": {"type": "string"},
          "coverage_limits": {"type": "string"},
          "sufficiency": {"type": "string", "enum": ["SUFFICIENT", "INSUFFICIENT", "PARTIAL"]}
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "gap_id": {"type": "string"},
          "question": {"type": "string"},
          "retrieval_state": {"type": "string"}
        }
      }
    },
    "collection_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {"type": "string"},
          "target": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}