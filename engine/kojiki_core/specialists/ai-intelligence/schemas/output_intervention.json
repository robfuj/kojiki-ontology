{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "objective": { "type": "string" },
    "owner": { "type": "string" },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": { "type": "string", "pattern": "^ACT-[A-Z0-9]{3,}$" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "dependencies": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["action_id", "description", "owner", "due_date", "dependencies"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "metric": { "type": "string" },
          "target": { "type": "number" },
          "operator": { "type": "string", "enum": [">=", "<=", "==", ">", "<"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["name", "metric", "target", "operator", "weight"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "risk_id": { "type": "string", "pattern": "^RSK-[A-Z0-9]{3,}$" },
          "description": { "type": "string" },
          "likelihood": { "type": "number", "minimum": 0, "maximum": 1 },
          "impact": { "type": "number", "minimum": 0, "maximum": 1 },
          "mitigation": { "type": "string" }
        },
        "required": ["risk_id", "description", "likelihood", "impact", "mitigation"],
        "additionalProperties": false
      }
    },
    "decision_rights": {
      "type": "object",
      "properties": {
        "own": { "type": "string" },
        "consult": { "type": "array", "items": { "type": "string" } },
        "inform": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["own", "consult", "inform"],
      "additionalProperties": false
    }
  },
  "required": ["objective", "owner", "actions", "success_criteria", "risks", "decision_rights"],
  "additionalProperties": false
}