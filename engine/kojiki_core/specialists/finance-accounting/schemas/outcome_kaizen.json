{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "outcome_id": { "type": "string", "pattern": "^OC-[A-Z0-9-]+$" },
    "period": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "metric": { "type": "string" },
          "target": { "type": "number" },
          "actual": { "type": "number" },
          "achieved": { "type": "boolean" },
          "variance_pct": { "type": "number" },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["name", "metric", "target", "actual", "achieved", "variance_pct", "weight"],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "guardrail_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "guardrail_id": { "type": "string" },
          "description": { "type": "string" },
          "severity": { "type": "string", "enum": ["warning", "critical"] },
          "action_taken": { "type": "string" }
        },
        "required": ["guardrail_id", "description", "severity", "action_taken"],
        "additionalProperties": false
      }
    },
    "decisions_triggered": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "decision_id": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        },
        "required": ["decision_id", "description", "owner", "status"],
        "additionalProperties": false
      }
    },
    "lessons": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["outcome_id", "period", "results", "guardrail_violations", "decisions_triggered", "lessons"],
  "additionalProperties": false
}