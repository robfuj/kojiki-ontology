{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "learning_id": { "type": "string", "pattern": "^KL-[A-Z0-9-]+$" },
    "period": { "type": "string" },
    "what_worked": { "type": "array", "items": { "type": "string" } },
    "what_failed": { "type": "array", "items": { "type": "string" } },
    "kaizen_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action_id": { "type": "string", "pattern": "^KA-[A-Z0-9-]+$" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "due_date": { "type": "string", "format": "date" },
          "success_metric": { "type": "string" },
          "status": { "type": "string", "enum": ["planned", "in_progress", "completed", "blocked"] }
        },
        "required": ["action_id", "description", "owner", "due_date", "success_metric", "status"],
        "additionalProperties": false
      }
    },
    "schema_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema": { "type": "string" },
          "change": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["schema", "change", "rationale"],
        "additionalProperties": false
      }
    },
    "prompt_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage": { "type": "string" },
          "change": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["stage", "change", "rationale"],
        "additionalProperties": false
      }
    },
    "decision_rights_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": { "type": "string" },
          "change": { "type": "string" },
          "rationale": { "type": "string" }
        },
        "required": ["node", "change", "rationale"],
        "additionalProperties": false
      }
    }
  },
  "required": ["learning_id", "period", "what_worked", "what_failed", "kaizen_actions", "schema_updates", "prompt_updates", "decision_rights_changes"],
  "additionalProperties": false
}