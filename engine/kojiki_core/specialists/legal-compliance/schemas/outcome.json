{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kojiki.org/schemas/outcome.json",
  "title": "OUTCOME Stage Output (Kaizen Loop)",
  "type": "object",
  "required": ["outcome_id", "output_ref", "actuals", "evaluations", "outcome_score", "target_met", "converged", "iteration_count"],
  "additionalProperties": false,
  "properties": {
    "outcome_id": {
      "type": "string",
      "pattern": "^OC-\\d{14}$",
      "description": "Unique outcome identifier (timestamp-based)"
    },
    "output_ref": {
      "type": "string",
      "pattern": "^OUT-\\d{3}$",
      "description": "Reference to OUTPUT stage"
    },
    "period": {
      "type": "string",
      "description": "Measurement period (YYYY-MM-DD)"
    },
    "actuals": {
      "type": "object",
      "description": "Measured actuals for each success criterion metric",
      "additionalProperties": { "type": "number" }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["criterion", "metric", "target", "actual", "operator", "passed", "weight"],
        "additionalProperties": false,
        "properties": {
          "criterion": { "type": "string" },
          "metric": { "type": "string" },
          "target": { "type": "number" },
          "actual": { "type": "number" },
          "operator": { "type": "string", "enum": [">=", "<=", "==", ">", "<"] },
          "passed": { "type": "boolean" },
          "weight": { "type": "number", "minimum": 0.1, "maximum": 2.0 }
        }
      },
      "minItems": 1
    },
    "outcome_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Weighted score of passed criteria"
    },
    "target_met": {
      "type": "boolean",
      "description": "Whether outcome_score >= convergence_threshold"
    },
    "converged": {
      "type": "boolean",
      "description": "Whether Kaizen Loop converged"
    },
    "iteration_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Number of PDCA iterations run"
    },
    "guardrail_violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["validator", "severity", "message"],
        "additionalProperties": false,
        "properties": {
          "validator": { "type": "string", "enum": ["completeness", "variance", "trend", "confidence_calibration"] },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string", "maxLength": 300 },
          "suggested_fix": { "type": "string", "maxLength": 300 },
          "learning_ref": { "type": "string" }
        }
      },
      "maxItems": 10
    },
    "deviation_analysis": {
      "type": "string",
      "maxLength": 500,
      "description": "Root cause analysis for any failed criteria"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence in outcome assessment"
    }
  }
}