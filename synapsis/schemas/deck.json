{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kojiki.org/schemas/deck.json",
  "title": "DECK Stage Output",
  "type": "object",
  "required": ["deck_id", "mode", "status", "plan", "dna_ref"],
  "additionalProperties": false,
  "properties": {
    "deck_id": {
      "type": "string",
      "pattern": "^DECK-\\d{3}$",
      "description": "Unique deck identifier"
    },
    "mode": {
      "type": "string",
      "enum": ["markdown", "native", "illustrated", "reconstruct", "studio"],
      "description": "Deck builder mode"
    },
    "status": {
      "type": "string",
      "enum": ["planned", "dna_extracted", "drafted", "qa_passed", "finalized"],
      "description": "Current deck status"
    },
    "plan": {
      "type": "object",
      "required": ["slides", "framework", "narrative"],
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slide_id", "title", "layout", "content_keys"],
            "additionalProperties": false,
            "properties": {
              "slide_id": { "type": "string", "pattern": "^S-\\d{2}$" },
              "title": { "type": "string", "maxLength": 100 },
              "layout": { "type": "string", "enum": ["answer_first", "mece_grouped", "scq_ordered", "storyboard", "charlie_hills"] },
              "content_keys": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Keys referencing output.content fields"
              }
            }
          },
          "minItems": 3,
          "maxItems": 20
        },
        "framework": {
          "type": "string",
          "enum": ["Pyramid Principle", "MECE", "SCQ", "Storyboarding", "Charlie Hills"],
          "description": "Consultant framework applied"
        },
        "narrative": {
          "type": "string",
          "maxLength": 500,
          "description": "High-level narrative arc"
        }
      }
    },
    "dna_ref": {
      "type": "string",
      "description": "Reference to extracted DNA file (dna-sheet.json)"
    },
    "validation": {
      "type": "object",
      "required": ["pyramid_passed", "mece_passed", "scq_passed"],
      "additionalProperties": false,
      "properties": {
        "pyramid_passed": { "type": "boolean" },
        "mece_passed": { "type": "boolean" },
        "scq_passed": { "type": "boolean" },
        "violations": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 10
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "dna_file": { "type": "string" },
        "plan_file": { "type": "string" },
        "draft_pptx": { "type": "string" },
        "final_pptx": { "type": "string" },
        "qa_report": { "type": "string" }
      }
    }
  }
}