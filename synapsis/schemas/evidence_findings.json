{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kojiki.org/schemas/evidence_findings.json",
  "title": "EVIDENCE Stage Output",
  "type": "object",
  "required": ["findings"],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^EVD-\\d{3}$"},
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["finding_id", "question", "answer", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^FE-\\d{3}$",
            "description": "Unique finding identifier"
          },
          "question": {
            "type": "string",
            "minLength": 5,
            "maxLength": 300,
            "description": "The specific question this finding answers"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Concise answer (one sentence, no prose)"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "description": "Source system/document (e.g., 'CRM Q3 2026', 'Analytics Dashboard')"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence in this finding (0-1)"
          },
          "retrieval_state": {
            "type": "string",
            "enum": ["RETRIEVED", "PARTIAL", "MISSING"],
            "default": "RETRIEVED",
            "description": "Retrieval status"
          },
          "coverage_limits": {
            "type": "string",
            "maxLength": 200,
            "description": "Known limitations (e.g., 'Q3 2026 only')"
          },
          "sufficiency": {
            "type": "string",
            "enum": ["SUFFICIENT", "INSUFFICIENT", "CONTRADICTED"],
            "default": "SUFFICIENT",
            "description": "Whether this finding alone suffices for the question"
          }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "items": {"type": "string", "maxLength": 200},
      "maxItems": 5,
      "description": "Questions still unanswered after evidence gathering"
    },
    "collection_plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "target"],
        "properties": {
          "action": {"type": "string", "enum": ["RETRIEVE", "COMPUTE", "SURVEY", "INTERVIEW"]},
          "target": {"type": "string", "maxLength": 300}
        }
      },
      "maxItems": 5,
      "description": "Plan to address evidence gaps"
    }
  }
}