{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "team_okrs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "team": { "type": "string" },
          "objective_id": { "type": "string", "pattern": "^OKR-[A-Za-z0-9.]+-P-[A-Z0-9]{8}-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 10 },
          "description": { "type": "string", "minLength": 20 },
          "key_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": { "type": "string" },
                "kr_type": { "type": "string", "enum": ["metric", "milestone"] },
                "target": { "type": "number" },
                "unit": { "type": "string" },
                "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                "source": { "type": "string" },
                "frequency": { "type": "string", "enum": ["weekly", "monthly", "quarterly"] },
                "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "is_leading": { "type": "boolean" }
              },
              "required": ["description", "kr_type", "target", "unit", "weight", "source", "frequency", "confidence", "is_leading"],
              "additionalProperties": false
            },
            "minItems": 3,
            "maxItems": 5
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "target_team": { "type": "string" },
                "weight": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "required": ["target_team", "weight"],
              "additionalProperties": false
            }
          }
        },
        "required": ["team", "objective_id", "title", "description", "key_results", "dependencies"],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": ["team_okrs"],
  "additionalProperties": false
}