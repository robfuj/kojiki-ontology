{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Chief of Staff Strategy Stage Output Schema (Department-Level Decomposition)",
  "type": "object",
  "required": ["strategy_id", "interpretation_ref", "objective", "rationale", "timeline", "success_criteria", "escalation_conditions", "actions"],
  "properties": {
    "strategy_id": {"type": "string", "pattern": "^STRAT-COS-\\d{12,}$"},
    "interpretation_ref": {"type": "string", "pattern": "^INT-\\d{3}$"},
    "objective": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "timeline": {"type": "string"},
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "metric", "target", "operator", "weight"],
        "properties": {
          "name": {"type": "string"},
          "metric": {"type": "string"},
          "target": {"type": "number"},
          "operator": {"type": "string", "enum": [">=", "<=", ">", "<", "=="]},
          "weight": {"type": "number", "minimum": 0}
        }
      }
    },
    "escalation_conditions": {"type": "array", "items": {"type": "string"}},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["owner", "description", "dependencies", "success_criteria"],
        "properties": {
          "owner": {"type": "string", "enum": ["Marketing", "Legal", "Finance", "Engineering", "Operations", "Sales", "People & Comms", "Technology Platform"]},
          "description": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "metric", "target", "operator", "weight"],
              "properties": {
                "name": {"type": "string"},
                "metric": {"type": "string"},
                "target": {"type": "number"},
                "operator": {"type": "string", "enum": [">=", "<=", ">", "<", "=="]},
                "weight": {"type": "number", "minimum": 0}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}